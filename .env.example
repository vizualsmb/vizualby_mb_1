RESEND_API_KEY=re_your_api_key
CONTACT_TO_EMAIL=hello@example.com
CONTACT_FROM_EMAIL=MB Portfolio <portfolio@your-verified-domain.com>

# Booking stays in clearly labelled preview mode until all launch gates pass.
# Never prefix these secrets with NEXT_PUBLIC_. See docs/BOOKING.md.
BOOKING_ENABLED=false
BOOKING_CATALOG_APPROVED=false
BOOKING_STRIPE_LIVE=false
BOOKING_POLICY_VERSION=
BOOKING_CANCELLATION_POLICY=
BOOKING_RESCHEDULING_POLICY=
BOOKING_BALANCE_POLICY=
CAL_API_KEY=
CAL_WEBHOOK_SECRET=
# Example only: replace IDs and links with your actual Cal event types.
CAL_BOOKING_EVENTS={}
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECTED_ACCOUNT_ID=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin dashboard (docs/ADMIN.md). Server-only: never add NEXT_PUBLIC_ to these.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Bypasses Row Level Security. Used only by verified webhooks and the login allowlist check.
SUPABASE_SECRET_KEY=
# Optional: the origin used in sign-in email links (defaults to the request host).
ADMIN_SITE_URL=https://admin.vizualbymb.com
# Daily automation: Vercel Cron sends this as a Bearer token. Use a long random value.
CRON_SECRET=
# Optional: where admin alerts go (defaults to CONTACT_TO_EMAIL).
ADMIN_NOTIFY_EMAIL=
# Optional: where clients land after paying a balance link.
BOOKING_SITE_URL=https://booking.vizualbymb.com

# SMS (Twilio). Server-only: do not use NEXT_PUBLIC_ names. Use either a sender
# number or a Messaging Service SID. Phone inputs are normalized to E.164; set
# the country code used for ten-digit local numbers (1 is US/Canada).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
SMS_DEFAULT_COUNTRY_CODE=1

# Base44/assistant server-to-server API. JSON map of client_id to a 32+ character
# secret; client_id is an identifier only. Requests sign these newline-separated
# values with HMAC-SHA256: v1, HTTP method, exact path+query, millisecond timestamp,
# nonce, and the SHA-256 hex digest of the raw body. Send X-Signature-Version: v1,
# X-Signature, X-Client-Id, X-Timestamp and X-Nonce. Mutations also require a
# unique Idempotency-Key.
ASSISTANT_API_CLIENTS={"MB001":"replace-with-a-random-32-character-secret"}
